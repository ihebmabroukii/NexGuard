suppress gen_id 1, sig_id 2001219, track by_src, ip 192.168.1.251    # Your host
suppress gen_id 1, sig_id 2010935, track by_src, ip 192.168.1.1      # Router/DNS
suppress gen_id 1, sig_id 2024218, track by_dst, ip 192.168.1.1      # DNS flood to router

# ----------------------------------------
# Limit noisy DNS alert rules (usually benign traffic)
# ----------------------------------------

threshold gen_id 1, sig_id 2010935, type limit, track by_src, count 5, seconds 30
threshold gen_id 1, sig_id 2024218, type limit, track by_src, count 3, seconds 20

# ----------------------------------------
# Brute-force SSH/FTP detection - limit to avoid spam
# ----------------------------------------

threshold gen_id 1, sig_id 2000419, type threshold, track by_dst, count 5, seconds 60
threshold gen_id 1, sig_id 2100365, type limit, track by_src, count 1, seconds 30

# ----------------------------------------
# Port scan suppression
# ----------------------------------------

threshold gen_id 1, sig_id 2002911, type threshold, track by_src, count 10, seconds 60
suppress gen_id 1, sig_id 2002911, track by_src, ip 192.168.1.251

# ----------------------------------------
# Web scanning or common bot rules
# ----------------------------------------

threshold gen_id 1, sig_id 2013030, type threshold, track by_dst, count 5, seconds 60
threshold gen_id 1, sig_id 2021001, type threshold, track by_dst, count 3, seconds 30

# ----------------------------------------
# Suppress alerts from Docker bridge or host networks (if using host mode)
# ----------------------------------------

suppress gen_id 1, sig_id 2001219, track by_src, ip 172.24.32.1
suppress gen_id 1, sig_id 2001219, track by_src, ip 127.0.0.1

# ----------------------------------------
# Logging system flood prevention
# ----------------------------------------

threshold gen_id 1, sig_id 2020543, type limit, track by_src, count 1, seconds 15
